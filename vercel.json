{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/novidade",
      "destination": "/pre-lancamento",
      "permanent": true
    },
    {
      "source": "/novidade.html",
      "destination": "/pre-lancamento",
      "permanent": true
    },
    {
      "source": "/imovel/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/?imovel=:id",
      "permanent": false
    },
    {
      "source": "/regiao/:slug",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|Iframely|vkShare|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/?regiao=:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pre-lancamento",
      "destination": "/pre-lancamento.html"
    },
    {
      "source": "/regiao/:slug/foto.jpg",
      "destination": "/api/regiao?slug=:slug&foto=1"
    },
    {
      "source": "/regiao/:slug",
      "destination": "/api/regiao?slug=:slug"
    },
    {
      "source": "/imovel/:id/foto.jpg",
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/imovel/:id",
      "destination": "/api/imovel?id=:id"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "{api/_fonts/**,api/_img/**,assets/logo-horizontal.png}"
    },
    "api/regiao.js": {
      "includeFiles": "{api/_fonts/**,api/_img/**,assets/logo-horizontal.png}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
